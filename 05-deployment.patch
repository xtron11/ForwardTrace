diff --git a/progress-backend/docker-compose.prod.yml b/progress-backend/docker-compose.prod.yml
new file mode 100644
index 0000000..0721544
--- /dev/null
+++ b/progress-backend/docker-compose.prod.yml
@@ -0,0 +1,50 @@
+# Production stack: database, API, and a reverse proxy that handles HTTPS.
+#
+#   docker compose -f docker-compose.prod.yml up -d --build
+#
+# Nothing but Caddy is exposed to the internet. Postgres and the API are reachable
+# only from inside the compose network, so there is no public database port to attack.
+
+services:
+  db:
+    image: postgres:16-alpine
+    restart: unless-stopped
+    environment:
+      POSTGRES_USER: progress
+      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}
+      POSTGRES_DB: progress
+    volumes:
+      - pgdata:/var/lib/postgresql/data
+    healthcheck:
+      test: ["CMD-SHELL", "pg_isready -U progress"]
+      interval: 5s
+      retries: 10
+
+  api:
+    build: .
+    restart: unless-stopped
+    env_file: .env
+    environment:
+      DATABASE_URL: postgresql+asyncpg://progress:${POSTGRES_PASSWORD}@db:5432/progress
+    volumes:
+      - audio:/app/data
+    depends_on:
+      db: {condition: service_healthy}
+
+  caddy:
+    image: caddy:2-alpine
+    restart: unless-stopped
+    ports: ["80:80", "443:443"]
+    environment:
+      API_DOMAIN: ${API_DOMAIN:?set API_DOMAIN in .env}
+    volumes:
+      - ./Caddyfile:/etc/caddy/Caddyfile:ro
+      - caddy_data:/data
+      - caddy_config:/config
+    depends_on: [api]
+
+volumes:
+  pgdata:
+  audio:
+  caddy_data:
+  caddy_config:
diff --git a/progress-backend/docker-entrypoint.sh b/progress-backend/docker-entrypoint.sh
new file mode 100644
index 0000000..ee3af73
--- /dev/null
+++ b/progress-backend/docker-entrypoint.sh
@@ -0,0 +1,11 @@
+#!/bin/sh
+set -e
+
+echo "Applying migrations..."
+alembic upgrade head
+
+echo "Starting API..."
+# One worker: background tasks live in-process, so a second worker would double
+# every scheduled job. Fine well past ten users.
+exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1 --proxy-headers \
+  --forwarded-allow-ips '*'
