diff --git a/progress-frontend/public/logo.svg b/progress-frontend/public/logo.svg
new file mode 100644
index 0000000..3a73fe9
--- /dev/null
+++ b/progress-frontend/public/logo.svg
@@ -0,0 +1,21 @@
+<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" fill="none" role="img" aria-label="ForwardTrace">
+  <!-- The F, drawn as a chunky outlined stroke. Uses currentColor so it inherits the
+       theme: bone on the dark skin, ink on the light one. -->
+  <path
+    d="M26 96V30a4 4 0 0 1 4-4h40"
+    stroke="currentColor" stroke-width="13" stroke-linecap="square"
+  />
+  <path d="M26 61h26" stroke="currentColor" stroke-width="13" stroke-linecap="square" />
+
+  <!-- The rising arrow, always the accent colour: this is the forward motion the whole
+       product is about, and it is the one thing allowed to carry it. -->
+  <path
+    d="M40 82 96 26"
+    stroke="var(--sunrise, #FFB020)" stroke-width="13" stroke-linecap="square"
+  />
+  <path
+    d="M68 24h30v30"
+    stroke="var(--sunrise, #FFB020)" stroke-width="13"
+    stroke-linecap="square" stroke-linejoin="miter"
+  />
+</svg>
