# ---- database ----
DATABASE_URL=postgresql+asyncpg://progress:progress@localhost:5432/progress

# ---- environment ----
# production | development | test. The app refuses to start with the placeholder
# JWT_SECRET from the code unless this is "test" (the test suite sets it itself).
APP_ENV=production

# ---- auth ----
# generate with: openssl rand -hex 32
JWT_SECRET=replace-me
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=60

# ---- speech to text ----
# deepgram: purpose-built STT, $200 starting credit (~46,000 minutes), per-second billing.
#           At 10 users x 1 min/day that credit lasts years.
# local:    faster-whisper on this machine. Free and private, but 8-30s per audio minute
#           on CPU. Uncomment faster-whisper in requirements.txt and install ffmpeg first.
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Leave EMPTY. Deepgram detects the language per recording, which survives a user whose
# browser language differs from the language they speak. Pinning the wrong language here
# does not fail - it returns fluent nonsense in the wrong language, which is far worse.
# Only set it if detection is genuinely struggling on your audio.
STT_LANGUAGE=
STT_DETECT_LANGUAGE=true
# true sends language=multi, for people who mix languages mid-sentence
# ("час писал на Python, застрял на recursion"). Disables keyterm prompting.
STT_MULTILINGUAL=false
# Extra attempts on rate limits, server errors and dropped connections. Bad audio or a
# bad key (400/401) is never repeated.
STT_MAX_RETRIES=2

# Domain vocabulary Deepgram should listen for (nova-3 only). Without it "recursion"
# comes back as "a course" and "LeetCode" as "leet code". Add the words your users
# actually say - frameworks, tools, jargon from their field.
STT_KEYTERMS=recursion,LeetCode,API,Python,TypeScript,refactor,debugging,endpoint

WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---- llm (extraction + report narration): OpenAI ----
# Seconds per call, ~$0.30/month at 10 users.
OPENAI_API_KEY=
# Use the explicit tier id: the bare "gpt-5.6" alias routes to the flagship.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
# Same rule as STT, plus a reply that is not valid JSON.
LLM_MAX_RETRIES=2

# ---- v2 models ----
# The conversation reply. Empty = OPENAI_MODEL.
CHAT_MODEL=
CHAT_REASONING_EFFORT=low
# safety_check on every message. Empty = OPENAI_MODEL.
SAFETY_MODEL=
# OpenAI embeddings model for facts. Empty = facts are found by date, not by meaning.
EMBEDDING_MODEL=

# ---- cost accounting (USD) ----
# Every check-in records what its speech-to-text and model calls cost. Neither provider
# returns prices, so they are set here - check the current price pages when you change
# models. Tokens are stored too, so a wrong price can be recomputed later.
STT_PRICE_PER_MIN=0.0043
# Prices per 1M tokens for OPENAI_MODEL. Left at 0, only tokens are counted (and the
# startup log says so). Cached input: uncomment to set; unset = the full input price.
LLM_PRICE_INPUT_PER_1M=0
# LLM_PRICE_CACHED_INPUT_PER_1M=
LLM_PRICE_OUTPUT_PER_1M=0
# CHAT_MODEL / SAFETY_MODEL prices, used only when they are a different model from
# OPENAI_MODEL. EMBEDDING_MODEL per 1M input tokens. To be filled in by the owner.
CHAT_PRICE_INPUT_PER_1M=0
# CHAT_PRICE_CACHED_INPUT_PER_1M=
CHAT_PRICE_OUTPUT_PER_1M=0
SAFETY_PRICE_INPUT_PER_1M=0
# SAFETY_PRICE_CACHED_INPUT_PER_1M=
SAFETY_PRICE_OUTPUT_PER_1M=0
EMBEDDING_PRICE_PER_1M=0

# ---- error tracking: Sentry ----
# Empty disables it. Create a Python/FastAPI project at sentry.io and paste its DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Share of requests and background jobs traced (0..1). Errors are always sent.
SENTRY_TRACES_SAMPLE_RATE=1.0

# ---- email ----
# Without a key nothing is sent and verification is skipped entirely, so local
# development needs no mail server. Get one at resend.com - 3000 letters a month free.
RESEND_API_KEY=
EMAIL_FROM=ForwardTrace <onboarding@resend.dev>
# Where the link in the letter points. The FRONTEND, not the API.
APP_URL=https://your-app.vercel.app
REQUIRE_VERIFIED_EMAIL=true

# ---- push reminders ----
# Generate once with: python -m app.vapid
# Changing these silently breaks every existing subscription - keep them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT_EMAIL=you@example.com
# Local hour, per user, for the daily nudge. Nobody is reminded on a day they have
# already checked in, and nobody is reminded twice in one day.
DEFAULT_REMINDER_HOUR=20
REMINDERS_ENABLED=true
# How often the scheduler wakes to look for people due a nudge (v2: the AI writing
# first runs on the same tick).
REMINDER_TICK_MINUTES=15

# ---- deployment (see DEPLOY.md) ----
# Only used by docker-compose.prod.yml.
POSTGRES_PASSWORD=
API_DOMAIN=

# ---- app ----
# Exact frontend origin, scheme included. A mismatch surfaces in the browser as a
# generic network error rather than as the CORS refusal it actually is.
CORS_ORIGINS=http://localhost:3000
# How many intentions can be in play at once. The person chooses how much they take
# on; past a handful, matching what they said against what they meant gets unreliable.
MAX_ACTIVE_TASKS=5
# Days of quiet after someone declines a suggestion.
TASK_SUGGESTION_COOLDOWN_DAYS=3

# Per-user daily quotas. Every voice check-in costs speech-to-text plus a model call,
# so an uncapped account can drain the API balance. Raise if real users hit the wall.
MAX_VOICE_ENTRIES_PER_DAY=3
MAX_TEXT_ENTRIES_PER_DAY=10
MAX_ONBOARDING_TRANSCRIBES_PER_DAY=5

# --- brute-force protection ---
# Per email and per IP. "5/15m" = five in any 15 minutes; "1/1m,5/1h" = both hold;
# empty = off. Sign-in counts wrong passwords only.
LOGIN_LIMIT_PER_EMAIL=5/15m
LOGIN_LIMIT_PER_IP=20/15m
ADMIN_LOGIN_LIMIT_PER_EMAIL=3/15m
ADMIN_LOGIN_LIMIT_PER_IP=10/1h
REGISTER_LIMIT_PER_EMAIL=3/1h
REGISTER_LIMIT_PER_IP=5/1h
RESEND_LIMIT_PER_EMAIL=1/1m,5/1h
RESEND_LIMIT_PER_IP=10/1h
# Header the edge writes the real client address into. Railway: X-Real-IP.
# Empty = the TCP connection, which behind any proxy is the proxy.
CLIENT_IP_HEADER=X-Real-IP

AUDIO_DIR=./data/audio
KEEP_AUDIO=true
REPORT_PERIOD_DAYS=7
MIN_ENTRIES_FOR_REPORT=3
# The first report lands early on purpose: a week of input before any output asks for
# more trust than a stranger's product gets, and people who quit before day seven never
# see what they were producing input for.
FIRST_REPORT_AFTER_DAYS=3
MIN_ENTRIES_FIRST_REPORT=2
ADMIN_EMAILS=you@example.com

# ======================================================================== v2
# Start values from the brief. Numbers of the product logic live here, not in code.

# ---- limit and the Plus door ----
FREE_TRIAL_DAYS=7
FREE_CONVERSATIONS_PER_WEEK=3
PLUS_BETA_DAYS=30

# ---- conversation ----
# Reply rules, checked after the stream; a violation is logged for review.
REPLY_MAX_WORDS=120
REPLY_MAX_WORDS_LONG=250
REPLY_LONG_INPUT_WORDS=150
CONTEXT_FACTS=5
CONTEXT_THREADS=5
CONTEXT_DAYS=3
NO_SPEECH_MIN_CHARS=10
MAX_TEXT_CHARS=4000
MAX_QUICK_REPLIES=5
FIRST_BASELINE_MAX_PAIRS=3
CALENDAR_MAX_DAYS=62

# ---- memory ----
MEMORY_IDLE_MINUTES=30
MEMORY_TICK_MINUTES=5
CLOSE_DAY_HOUR=4
MEMORY_RECENT_FACTS=50
PAIR_MIN_DAYS=7
PAIR_MIN_SIMILARITY=0.8

# ---- monthly summary ----
MONTHLY_MIN_CONVERSATIONS=8
MONTHLY_MIN_PAIRS=2
MONTHLY_TICK_MINUTES=60

# ---- the AI writes first ----
OUTREACH_MAX_WORDS=25
OUTREACH_PAUSE_AFTER=3
OUTREACH_PAUSE_EVERY_DAYS=3
OUTREACH_FAREWELL_DAYS=14
OUTREACH_THREAD_RECENT_DAYS=3
OUTREACH_ANCHOR_SILENCE_DAYS=2

# ---- safety ----
# Help lines per country, JSON. Fill in from official sources only - never invent a
# number or a service name. Example shape (values left for the owner):
# {"KZ": [{"name": "", "contact": ""}], "default": [{"name": "", "contact": ""}]}
SAFETY_RESOURCES={}
SAFETY_HELP_WINDOW_DAYS=14
SAFETY_HELP_MIN_DAYS=5
SAFETY_HELP_COOLDOWN_DAYS=14

# ---- Telegram ----
# Without a token every Telegram endpoint answers 503 and the channel is hidden.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Compared with the X-Telegram-Bot-Api-Secret-Token header on the webhook.
TELEGRAM_WEBHOOK_SECRET=
