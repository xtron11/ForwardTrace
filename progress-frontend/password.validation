<!DOCTYPE HTML>
<html lang="ru">
<head>
  <title>Валидация пароля </title>
  <meta charset= "UTF-8">
  <link rel="stylesheet" bref="style.css">
</head>
<body>
 <div class="validation-block">
   <h2 class="validation-block__title">Валидация пароля</h2>
   <div class="validation-block__item">
    <input type="password" id="password"
    placeholder="Введите пароль"
    class="validation-block__input">
    <div class="validation-block__progress-bar">
      <span id="progress"></span>
    </div>
 </div>
  <ul class="validation-block__criteria">
   <li class="validation-block__criterion"
    id="length">Не короче 10 символов</li>
    <li class="validation-block__criterion"
    id="number">Число</li>
    <li class="validation-block__criterion"
    id="symbol">Специальный символ (например, @, #,)</li>
  </ul>
</div>
<script src="script.js"></script>
</body>
</html>
