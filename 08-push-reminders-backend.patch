diff --git a/progress-backend/app/services/push.py b/progress-backend/app/services/push.py
new file mode 100644
index 0000000..581863c
--- /dev/null
+++ b/progress-backend/app/services/push.py
@@ -0,0 +1,93 @@
+"""Web Push delivery.
+
+Reminders go here rather than to email because an inbox is where a nudge goes to die.
+The rule that keeps this from becoming spam is in the scheduler, not here: nobody is
+reminded on a day they have already checked in.
+"""
+
+import asyncio
+import json
+import logging
+
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from ..config import settings
+from ..models import PushSubscription
+
+log = logging.getLogger(__name__)
+
+# A subscription that fails this many times in a row is gone: the browser was
+# uninstalled, the permission revoked, the endpoint rotated. Retrying forever wastes
+# requests and hides real failures in the noise.
+MAX_FAILURES = 3
+
+
+class PushError(RuntimeError):
+    pass
+
+
+def _send_sync(subscription: PushSubscription, payload: dict) -> int:
+    """Returns the HTTP status. Blocking, so callers run it in a thread."""
+    from pywebpush import WebPushException, webpush
+
+    try:
+        response = webpush(
+            subscription_info={
+                "endpoint": subscription.endpoint,
+                "keys": {"p256dh": subscription.p256dh, "auth": subscription.auth},
+            },
+            data=json.dumps(payload, ensure_ascii=False),
+            vapid_private_key=settings.vapid_private_key,
+            vapid_claims={"sub": f"mailto:{settings.vapid_subject_email}"},
+            ttl=settings.push_ttl_seconds,
+        )
+        return response.status_code
+    except WebPushException as exc:
+        status = getattr(exc.response, "status_code", 0)
+        # 404 and 410 are the browser telling us the subscription no longer exists.
+        if status in (404, 410):
+            return status
+        raise PushError(str(exc)[:300]) from exc
+
+
+async def send_to_user(db: AsyncSession, user_id, payload: dict) -> int:
+    """Push to every device this person has registered. Returns how many got through."""
+    if not settings.vapid_private_key:
+        log.warning("push requested but VAPID_PRIVATE_KEY is not set")
+        return 0
+
+    subscriptions = (
+        (
+            await db.execute(
+                select(PushSubscription).where(PushSubscription.user_id == user_id)
+            )
+        )
+        .scalars()
+        .all()
+    )
+
+    delivered = 0
+    for subscription in subscriptions:
+        try:
+            status = await asyncio.to_thread(_send_sync, subscription, payload)
+        except PushError as exc:
+            log.warning("push to %s failed: %s", subscription.id, exc)
+            subscription.failure_count += 1
+            if subscription.failure_count >= MAX_FAILURES:
+                await db.delete(subscription)
+            continue
+
+        if status in (404, 410):
+            # Definitively dead; no point counting toward a threshold.
+            await db.delete(subscription)
+            continue
+
+        from datetime import datetime, timezone
+
+        subscription.failure_count = 0
+        subscription.last_success_at = datetime.now(timezone.utc)
+        delivered += 1
+
+    await db.commit()
+    return delivered
diff --git a/progress-backend/app/services/reminders.py b/progress-backend/app/services/reminders.py
new file mode 100644
index 0000000..aabe0a7
--- /dev/null
+++ b/progress-backend/app/services/reminders.py
@@ -0,0 +1,124 @@
+"""The daily nudge.
+
+The product asks for input every day and pays it back later. That gap is where people
+quit, and most of them quit by forgetting rather than by deciding. A reminder is the
+cheapest thing that closes it.
+
+Two rules keep this from becoming spam, and both are here rather than in the sender:
+
+  * nobody is reminded on a day they have already checked in;
+  * nobody is reminded twice in a day, however often the loop wakes.
+
+Runs in-process on a timer. For ten users that is right; a real queue is worth having
+at the point where a second API worker is, and not before.
+"""
+
+import asyncio
+import logging
+from datetime import datetime, timezone
+
+from sqlalchemy import select
+
+from ..config import settings
+from ..db import SessionLocal
+from ..models import Entry, PushSubscription, User
+from ..time_utils import local_today, tz_of
+from . import push
+
+log = logging.getLogger(__name__)
+
+MESSAGES = {
+    "en": {
+        "title": "How did today go?",
+        "body": "Thirty seconds. What you worked on, what got in the way.",
+    },
+    "ru": {
+        "title": "Как прошёл день?",
+        "body": "Тридцать секунд. Над чем работал, что помешало.",
+    },
+}
+
+
+def _local_hour(tz_name: str | None, now: datetime) -> int:
+    return now.astimezone(tz_of(tz_name)).hour
+
+
+async def _due_users(db, now: datetime) -> list[User]:
+    """People whose local evening has arrived, who have a device, and who have not
+    checked in today."""
+    candidates = (
+        (
+            await db.execute(
+                select(User)
+                .where(User.is_active.is_(True), User.reminders_on.is_(True))
+                .where(User.id.in_(select(PushSubscription.user_id)))
+            )
+        )
+        .scalars()
+        .all()
+    )
+
+    due = []
+    for user in candidates:
+        today = local_today(user.timezone, now)
+        if user.last_reminded_on == today:
+            continue
+        if _local_hour(user.timezone, now) != user.reminder_hour:
+            continue
+
+        already = (
+            await db.execute(
+                select(Entry.id)
+                .where(Entry.user_id == user.id, Entry.local_date == today)
+                .limit(1)
+            )
+        ).scalar_one_or_none()
+        if already is not None:
+            # Reminding someone to do a thing they have done is worse than silence.
+            continue
+
+        due.append(user)
+    return due
+
+
+async def run_once(now: datetime | None = None) -> int:
+    """One pass. Returns how many people were reminded."""
+    if not settings.vapid_private_key:
+        return 0
+
+    moment = now or datetime.now(timezone.utc)
+    reminded = 0
+
+    async with SessionLocal() as db:
+        for user in await _due_users(db, moment):
+            text = MESSAGES.get((user.locale or "en")[:2], MESSAGES["en"])
+            delivered = await push.send_to_user(
+                db,
+                user.id,
+                {"title": text["title"], "body": text["body"], "url": "/today"},
+            )
+            # Mark it either way: a person whose devices have all gone stale should not
+            # be retried every quarter of an hour until midnight.
+            user.last_reminded_on = local_today(user.timezone, moment)
+            await db.commit()
+            if delivered:
+                reminded += 1
+
+    if reminded:
+        log.info("reminders sent to %s people", reminded)
+    return reminded
+
+
+async def loop() -> None:
+    """Background task started at app startup and cancelled at shutdown."""
+    interval = settings.reminder_tick_minutes * 60
+    log.info("reminder loop started, every %s minutes", settings.reminder_tick_minutes)
+    while True:
+        try:
+            await asyncio.sleep(interval)
+            await run_once()
+        except asyncio.CancelledError:
+            log.info("reminder loop stopped")
+            raise
+        except Exception:  # noqa: BLE001 - a scheduler that dies silently is worse
+            log.exception("reminder pass failed; continuing")
diff --git a/progress-backend/app/vapid.py b/progress-backend/app/vapid.py
new file mode 100644
index 0000000..ba6cf6d
--- /dev/null
+++ b/progress-backend/app/vapid.py
@@ -0,0 +1,40 @@
+"""Generate a VAPID keypair.
+
+    python -m app.vapid
+
+Run once. The keys identify this server to the browsers' push services; rotating them
+invalidates every existing subscription, so store them and do not regenerate casually.
+"""
+
+import base64
+
+from cryptography.hazmat.primitives import serialization
+from cryptography.hazmat.primitives.asymmetric import ec
+
+
+def _b64(raw: bytes) -> str:
+    return base64.urlsafe_b64encode(raw).rstrip(b"=").decode()
+
+
+def main() -> None:
+    private_key = ec.generate_private_key(ec.SECP256R1())
+    public_numbers = private_key.public_key().public_numbers()
+
+    public_raw = (
+        b"\x04"
+        + public_numbers.x.to_bytes(32, "big")
+        + public_numbers.y.to_bytes(32, "big")
+    )
+    private_raw = private_key.private_numbers().private_value.to_bytes(32, "big")
+
+    print("VAPID_PUBLIC_KEY=" + _b64(public_raw))
+    print("VAPID_PRIVATE_KEY=" + _b64(private_raw))
+    print()
+    print("Put both in the environment. The public key is also sent to the browser;")
+    print("the private key never leaves the server.")
+    # Silence the unused-import warning while keeping the dependency explicit.
+    _ = serialization
+
+
+if __name__ == "__main__":
+    main()
